@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SpotyWrap</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="user">
                <span class="bi bi-person-circle" aria-hidden="true"></span> User Profile
            </NavLink>
        </div>
        @if (isAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="generator">
                    <span class="bi bi-spotify" aria-hidden="true"></span> Generator
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="allliked">
                    <span class="bi bi-heart-fill" aria-hidden="true"></span> All Liked
                </NavLink>
            </div>
        }
    </nav>
</div>


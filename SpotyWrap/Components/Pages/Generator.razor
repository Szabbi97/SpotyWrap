@page "/generator"
@rendermode InteractiveServer

<PageTitle>Generator</PageTitle>

<h1>Generator</h1>

@if (!isLoaded)
{
    <p>Loading...</p>
}
else if (AuthStateService.IsAuthenticated)
{
    <div class="text-center">
        <button class="btn btn-success btn-lg" @onclick="GenerateThis">
          <i class="bi bi-spotify"></i> Generate this month
        </button>
    </div>
    <div class="text-center">
        <button class="btn btn-success btn-lg" @onclick="GenerateAll">
            <i class="bi bi-spotify"></i> Generate all
     </button>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle"></i> 
        Please <a href="/user" class="alert-link">login with Spotify</a> to use the generator.
    </div>
}

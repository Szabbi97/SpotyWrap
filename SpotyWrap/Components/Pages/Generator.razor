@page "/generator"
@rendermode InteractiveServer

<PageTitle>Generator</PageTitle>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">
            <i class="bi bi-magic"></i> Playlist Generator
        </h1>
        <p class="lead text-muted">Create playlists from your liked songs automatically</p>
    </div>

    @if (!isLoaded)
    {
        <div class="text-center">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading...</p>
        </div>
    }
    else if (AuthStateService.IsAuthenticated)
    {
        <div class="row g-4 justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="text-center mb-3">
                            <i class="bi bi-calendar-month text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h3 class="card-title text-center mb-3">Generate This Month</h3>
                        <p class="card-text text-muted flex-grow-1">
                            Creates a playlist containing all songs you've liked during the current month. 
                            Perfect for capturing your recent music discoveries and favorites.
                        </p>
                        <div class="mt-3">
                            <button class="btn btn-success btn-lg w-100" @onclick="GenerateThis">
                                <i class="bi bi-spotify"></i> Generate Current Month
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-5">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="text-center mb-3">
                            <i class="bi bi-calendar-range text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h3 class="card-title text-center mb-3">Generate All Playlists</h3>
                        <p class="card-text text-muted flex-grow-1">
                            Automatically organizes all your liked songs into monthly playlists. 
                            Each playlist will be named by year and month (e.g., "2024.1") for easy browsing of your music timeline.
                        </p>
                        <div class="mt-3">
                            <button class="btn btn-success btn-lg w-100" @onclick="GenerateAll">
                                <i class="bi bi-spotify"></i> Generate All Months
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="text-center mb-3">
                            <i class="bi bi-trophy-fill text-success" style="font-size: 3rem;"></i>
                        </div>
                        <h3 class="card-title text-center mb-3">Generate Monthly Top</h3>
                        <p class="card-text text-muted flex-grow-1">
                            Creates a curated playlist combining your top 50 tracks with songs you've liked this month. 
                            Liked songs receive a popularity boost, ensuring your personal favorites rank higher in the final mix.
                        </p>
                        <div class="mt-3">
                            <button class="btn btn-success btn-lg w-100" @onclick="GenerateMonthlyTop">
                                <i class="bi bi-spotify"></i> Generate Monthly Top
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="alert alert-info mt-4" role="alert">
            <i class="bi bi-info-circle"></i> 
            <strong>Note:</strong> Playlists will be created as private and won't duplicate if they already exist.
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle me-3" style="font-size: 2rem;"></i>
                <div>
                    <h5 class="alert-heading mb-1">Authentication Required</h5>
                    <p class="mb-0">
                        Please <a href="/user" class="alert-link fw-bold">login with Spotify</a> to use the playlist generator.
                    </p>
                </div>
            </div>
        </div>
    }
</div>

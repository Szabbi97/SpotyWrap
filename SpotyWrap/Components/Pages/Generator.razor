@page "/generator"
@rendermode InteractiveServer

<PageTitle>Generator</PageTitle>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">
            <i class="bi bi-magic"></i> Playlist Generator
        </h1>
        <p class="lead text-muted">Create playlists from your liked songs automatically</p>
    </div>

    @if (!isLoaded)
    {
        <div class="text-center">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading...</p>
        </div>
    }
    else if (AuthStateService.IsAuthenticated)
    {
        @if (isGenerating)
        {
            <div class="text-center mb-5">
                <div class="card shadow-sm border-0 p-5">
                    <div class="card-body">
                        <div class="spinner-border text-success mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Generating...</span>
                        </div>
                        <h4 class="fw-bold mb-2">Generating Playlist</h4>
                        <p class="text-muted mb-0">@generatingMessage</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hover-card">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="text-center mb-4">
                                <div class="icon-circle mx-auto mb-3">
                                    <i class="bi bi-calendar-month"></i>
                                </div>
                                <h3 class="card-title h4 fw-bold mb-3">This Month</h3>
                                <p class="card-text text-muted small flex-grow-1">
                                    Creates a playlist containing all songs you've liked during the current month. 
                                    Perfect for capturing your recent music discoveries and favorites.
                                </p>
                            </div>
                            <div class="mt-auto">
                                <button class="btn btn-success btn-lg w-100 fw-semibold" @onclick="GenerateThis">
                                    <i class="bi bi-spotify me-2"></i>Generate
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hover-card">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="text-center mb-4">
                                <div class="icon-circle mx-auto mb-3">
                                    <i class="bi bi-calendar-range"></i>
                                </div>
                                <h3 class="card-title h4 fw-bold mb-3">All Months</h3>
                                <p class="card-text text-muted small flex-grow-1">
                                    Automatically organizes all your liked songs into monthly playlists. 
                                    Each playlist will be named by year and month (e.g., "2024.1") for easy browsing of your music timeline.
                                </p>
                            </div>
                            <div class="mt-auto">
                                <button class="btn btn-success btn-lg w-100 fw-semibold" @onclick="GenerateAll">
                                    <i class="bi bi-spotify me-2"></i>Generate
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm border-0 hover-card">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="text-center mb-4">
                                <div class="icon-circle mx-auto mb-3">
                                    <i class="bi bi-trophy-fill"></i>
                                </div>
                                <h3 class="card-title h4 fw-bold mb-3">Monthly Top</h3>
                                <p class="card-text text-muted small flex-grow-1">
                                    Creates a curated playlist combining your top 50 tracks with songs you've liked this month. 
                                    Liked songs receive a popularity boost, ensuring your personal favorites rank higher in the final mix.
                                </p>
                            </div>
                            <div class="mt-auto">
                                <button class="btn btn-success btn-lg w-100 fw-semibold" @onclick="GenerateMonthlyTop">
                                    <i class="bi bi-spotify me-2"></i>Generate
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info border-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-info-circle me-3" style="font-size: 1.5rem;"></i>
                    <div>
                        <strong>Note:</strong> Playlists will be created as private and won't duplicate if they already exist.
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning shadow-sm border-0" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle me-3" style="font-size: 2rem;"></i>
                <div>
                    <h5 class="alert-heading mb-1">Authentication Required</h5>
                    <p class="mb-0">
                        Please <a href="/user" class="alert-link fw-bold">login with Spotify</a> to use the playlist generator.
                    </p>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1ed760 0%, #1aa34a 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(30, 215, 96, 0.3);
    }

    .icon-circle i {
        font-size: 2.5rem;
        color: white;
    }

    .hover-card {
        transition: all 0.3s ease;
    }

    .hover-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
    }

    .hover-card:hover .icon-circle {
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(30, 215, 96, 0.4);
    }

    .btn-success {
        background: linear-gradient(135deg, #1ed760 0%, #1aa34a 100%);
        border: none;
        transition: all 0.3s ease;
    }

    .btn-success:hover {
        background: linear-gradient(135deg, #1aa34a 0%, #158a3d 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(30, 215, 96, 0.4);
    }
</style>

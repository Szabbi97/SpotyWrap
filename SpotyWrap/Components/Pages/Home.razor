@page "/"
@rendermode InteractiveServer

<PageTitle>SpotyWrap - Home</PageTitle>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">Welcome to SpotyWrap!</h1>
        <p class="lead text-muted">Your Spotify statistics at a glance</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 mb-4">What is SpotyWrap?</h2>
                    <p class="mb-3">
                        SpotyWrap is a web application that connects to your Spotify account
                        and creates monthly playlists from your liked songs. Organize your favorite
                        music by the month you added them.
                    </p>
                    <p class="mb-3">
                        Connect your Spotify account to get started and automatically generate
                        playlists based on when you liked each song!
                    </p>
                    @if (!isLoaded)
                    {
                        <div class="mt-4 text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (!AuthStateService.IsAuthenticated)
                    {
                        <div class="mt-4 text-center">
                            <button class="btn btn-success btn-lg" @onclick="Login">
                                <i class="bi bi-spotify"></i> Get Started!
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@page "/toptracks"
@rendermode InteractiveServer

<PageTitle>My Top Tracks</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-trophy-fill text-danger"></i> My Top Tracks</h1>
        
        @if (isLoaded && AuthStateService.IsAuthenticated)
        {
            <div class="custom-dropdown">
                <div class="dropdown-header" @onclick="ToggleDropdown">
                    <span>@termOptions.FirstOrDefault(x => x.Value == selectedTimeRange).Key</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
                @if (isDropdownOpen)
                {
                    <div class="dropdown-menu-custom">
                        @foreach (var option in termOptions)
                        {
                            <div class="dropdown-item-custom @(option.Value == selectedTimeRange ? "selected" : "")" 
                                 @onclick="() => SelectTimeRange(option.Value)">
                                @option.Key
                                @if (option.Value == selectedTimeRange)
                                {
                                    <i class="bi bi-check2 ms-2"></i>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (!isLoaded)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading your liked songs...</p>
        </div>
    }
    else if (!AuthStateService.IsAuthenticated)
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            Please <a href="/user" class="alert-link">login with Spotify</a> to view your top songs.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th style="width: 60px;"></th>
                        <th>Title</th>
                        <th>Artist</th>
                        <th>Album</th>
                        <th style="width: 100px;">Duration</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (item, index) in topTracks.Select((item, i) => (item, i)))
                    {
                        <tr>
                            <td class="text-muted">@(index + 1)</td>
                            <td>
                                @if (item.Album.Images.Any())
                                {
                                    <img src="@item.Album.Images.Last().Url" alt="Album Art" class="img-fluid" style="width: 50px; height: 50px;" />
                                }
                                else
                                {
                                    <i class="bi bi-music-note" style="font-size: 2rem; color: gray;"></i>
                                }
                            </td>
                            <td>@item.Name</td>
                            <td>@string.Join(", ", item.Artists.Select(a => a.Name))</td>
                            <td>@item.Album.Name</td>
                            <td>@TimeSpan.FromMilliseconds(item.DurationMs).ToString(@"mm\:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
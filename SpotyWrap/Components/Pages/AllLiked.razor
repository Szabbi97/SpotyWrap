@page "/allliked"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<PageTitle>All Liked Songs</PageTitle>

<div class="container-fluid">
    <h1 class="mb-4"><i class="bi bi-heart-fill text-danger"></i> All Liked Songs</h1>

    @if (!isLoaded)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading your liked songs...</p>
        </div>
    }
    else if (string.IsNullOrEmpty(accessToken))
    {
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-exclamation-triangle"></i> 
            Please <a href="/user" class="alert-link">login with Spotify</a> to view your liked songs.
        </div>
    }
    else if (allTracks.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> 
            You don't have any liked songs yet.
        </div>
    }
    else
    {
        <div class="mb-3">
            <p class="text-muted">
                <i class="bi bi-music-note-list"></i> 
                Showing @allTracks.Count @(likedSongsData != null ? $"of {likedSongsData.Total}" : "") liked songs
            </p>
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th style="width: 60px;">#</th>
                        <th style="width: 60px;"></th>
                        <th>Title</th>
                        <th>Artist</th>
                        <th>Album</th>
                        <th style="width: 100px;">Duration</th>
                        <th style="width: 120px;">Added</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (item, index) in allTracks.Select((item, i) => (item, i)))
                    {
                        <tr>
                            <td class="text-muted">@(index + 1)</td>
                            <td>
                                @if (item.Track.Album.Images.Any())
                                {
                                    <img src="@item.Track.Album.Images.Last().Url"
                                         alt="Album cover"
                                         class="img-thumbnail"
                                         style="width: 40px; height: 40px; object-fit: cover;" />
                                }
                            </td>
                            <td>
                                <strong>@item.Track.Name</strong>
                                @if (item.Track.Explicit)
                                {
                                    <span class="badge bg-secondary">E</span>
                                }
                            </td>
                            <td>
                                @string.Join(", ", item.Track.Artists.Select(a => a.Name))
                            </td>
                            <td class="text-muted">@item.Track.Album.Name</td>
                            <td class="text-muted">@FormatDuration(item.Track.DurationMs)</td>
                            <td class="text-muted">@item.AddedAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrEmpty(nextUrl))
        {
            <div class="text-center my-4">
                <button class="btn btn-success btn-lg" 
                        @onclick="LoadMoreSongs" 
                        disabled="@isLoadingMore">
                    @if (isLoadingMore)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Loading...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-down-circle me-2"></i>
                        <span>Load More Songs</span>
                    }
                </button>
            </div>
        }
        else if (likedSongsData != null && allTracks.Count >= likedSongsData.Total)
        {
            <div class="text-center my-4 text-muted">
                <i class="bi bi-check-circle"></i> 
                <p>You've reached the end of your liked songs!</p>
            </div>
        }
    }
</div>

@code {
    private string FormatDuration(int durationMs)
    {
        var duration = TimeSpan.FromMilliseconds(durationMs);
        return $"{(int)duration.TotalMinutes}:{duration.Seconds:D2}";
    }
}
